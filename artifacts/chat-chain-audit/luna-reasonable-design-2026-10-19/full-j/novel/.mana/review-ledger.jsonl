62848bd18"},{"resourceRef":"character-memory:lin","hash":"590980fd4c0c2b8be8e6406aa8e0b32504256e3f95c4d5a9495b0faaa96d555e"},{"resourceRef":"character:lu","hash":"dc5428b67ec0d3cd000e214d01258a0731f7ba31285f1afaa17f77f4903d7912"},{"resourceRef":"character-memory:lu","hash":"28ec892968bd9a24d45a733424a1b5a15b861b7ced16721dd4ce41f3187ae760"},{"resourceRef":"character:su","hash":"1184058a913bc24b35f71437aff4ae3a68a2b39b52b8adee2a0776868db3a42b"},{"resourceRef":"character-memory:su","hash":"31711929cfe4a14531d50cfbb3d1c5514d9fbced2cca2a7ae8211bb996c89078"},{"resourceRef":"character:ye","hash":"37cf870ba83e55c4c3ba1437a5a06ed34dc3198e4b6f2a51977c8edae99df9ce"},{"resourceRef":"character-memory:ye","hash":"c352fe8b5b712322b44103aa01dead2d3417129fb18c777e227d5fc22632d0fe"}],"versionCurrent":false,"narrativeAudit":{"status":"reported","errors":[],"reviewedResourceRefs":["chapter:chapter-002.md"],"requestedResourceRefs":["chapter:chapter-002.md"],"aspects":["character","world","timeline","viewpoint"],"limitations":["审查仅依据提供的sources.lines及角色、世界观、大纲与文风资料；不声称证明全文无错。","没有提供priorFindings，故无既有问题可作关闭或维持结论。","未将动作未逐项写出耗时本身判为不可能；本章20:05至20:20的时序未发现其他确定矛盾。"],"qualityConclusion":"model_reported"},"invalidatedIssueIds":[],"coverageVerified":false,"evidenceVerified":false,"issues":[{"issueId":"content:review:668086be-43cb-4ec8-9f12-62a3e1ce601e","category":"timeline/continuity","sourceKey":null,"affectedResourceRefs":["chapter:chapter-002.md"],"severity":"suspicion","requestedSeverity":"hard","schemaValid":true,"status":"open","contradiction":"本章写20:20船头已离开木桩，随后林岚才跨上船；但同段说她等到叶澄确认药箱固定才上船。前文明确陆行舟已先托住药箱，且在20:12决定启航，场景地点一直是旧渡口。把林岚写成船离桩后才登船，造成她在岸上目送船离开却又登上船的空间连续性矛盾。","evidence":[{"resourceRef":"chapter:chapter-002.md","hash":"8af8be98876b72489058c8314990645494e9747275e0b9633d1e1c441367d8b7","bindReadVersion":true,"location":"","quote":"他在通行证下方写下时刻：20:12。林岚核过笔迹，又在旁边签下潮况核验。双印已成，出港的决定也落了纸。","quoteOffset":-1,"versionSource":"actual_content_read","currentHash":"21a2635e5ac7bc2467afc73444e4e08070293874207ba58c2842f3fd1328900b","sourceCurrent":false,"quoteLocated":false,"observed":false,"verified":false},{"resourceRef":"chapter:chapter-002.md","hash":"8af8be98876b72489058c8314990645494e9747275e0b9633d1e1c441367d8b7","bindReadVersion":true,"location":"","quote":"何芷打开冰柜，把药箱抱出来。铅封在油灯下泛着暗光，完好无损。叶澄解开缆绳，陆行舟上前搭手，先看过系带再托住箱底。岑寂收起公文，没有碰药箱。","quoteOffset":-1,"versionSource":"actual_content_read","currentHash":"21a2635e5ac7bc2467afc73444e4e08070293874207ba58c2842f3fd1328900b","sourceCurrent":false,"quoteLocated":false,"observed":false,"verified":false},{"resourceRef":"chapter:chapter-002.md","hash":"8af8be98876b72489058c8314990645494e9747275e0b9633d1e1c441367d8b7","bindReadVersion":true,"location":"","quote":"20:20，船头离开木桩。她站在岸上看着缆绳收紧，直到叶澄确认药箱固定，才跨上船。渡口在雾里退成一线，通行证上的两枚印仍压在她怀中。","quoteOffset":-1,"versionSource":"actual_content_read","currentHash":"21a2635e5ac7bc2467afc73444e4e08070293874207ba58c2842f3fd1328900b","sourceCurrent":false,"quoteLocated":false,"observed":false,"verified":false},{"resourceRef":"outline:master","hash":"7e36c4d2b0d88a30c85b2752e9c71f543e23e88d6de3f0189bfd6c2a97a3ea91","bindReadVersion":true,"location":"L3","quote":"第二章20:05—20:20，林岚视角，在渡口完成双印和是否启航的决定，不必抵达灯塔。","quoteOffset":169,"versionSource":"actual_content_read","currentHash":"7e36c4d2b0d88a30c85b2752e9c71f543e23e88d6de3f0189bfd6c2a97a3ea91","sourceCurrent":true,"quoteLocated":true,"observed":true,"verified":true}],"resolution":null,"evidenceComplete":true,"verified":false,"sourceSnapshots":{"outline:master":"# 总纲\n六人在封桥前运送冷藏药，因时间、程序和隐藏的账页相互试探。最终依据证据达成有限信任。不得一次揭开所有秘密。\n第二章20:05—20:20，林岚视角，在渡口完成双印和是否启航的决定，不必抵达灯塔。\n第三章紧接第二章，用角色主观动机推动阻力、选择与后果。"}},{"issueId":"content:review:940c2605-7dac-4665-8faa-c835b9b1ae3f","category":"viewpoint","sourceKey":null,"affectedResourceRefs":["chapter:chapter-002.md"],"severity":"suspicion","requestedSeverity":"suspicion","schemaValid":true,"status":"open","contradiction":"林岚有限视角中，何芷检查封蜡后“才取过自己的医师印”并盖印，但正文没有交代医师印此前由谁持有、如何取得；可能只是省略普通动作，现有材料不能据此断定视角违规或物品凭空出现。","evidence":[{"resourceRef":"chapter:chapter-002.md","hash":"8af8be98876b72489058c8314990645494e9747275e0b9633d1e1c441367d8b7","bindReadVersion":true,"location":"","quote":"何芷没接。“我签的是药物和去向，不替议事厅的文书担保。”","quoteOffset":-1,"versionSource":"actual_content_read","currentHash":"21a2635e5ac7bc2467afc73444e4e08070293874207ba58c2842f3fd1328900b","sourceCurrent":false,"quoteLocated":false,"observed":false,"verified":false},{"resourceRef":"chapter:chapter-002.md","hash":"8af8be98876b72489058c8314990645494e9747275e0b9633d1e1c441367d8b7","bindReadVersion":true,"location":"","quote":"何芷的目光停在巡港印上，又落到药箱铅封上。她检查封蜡边缘，确认没有裂痕，才取过自己的医师印。印面落下去时，她手腕稳，纸却被潮气洇软了一角。两枚印并排留在通行证上，一红一褐。","quoteOffset":-1,"versionSource":"actual_content_read","currentHash":"21a2635e5ac7bc2467afc73444e4e08070293874207ba58c2842f3fd1328900b","sourceCurrent":false,"quoteLocated":false,"observed":false,"verified":false},{"resourceRef":"style:memory","hash":"7c76d0ac1289ce22ec2af937ae3ef096560769633aecd8841941fb3b2beb5839","bindReadVersion":true,"location":"L1","quote":"第三人称有限视角，一场只跟随一个焦点人物。用动作和对话呈现冲突，不给他人直接内心独白。禁用现代技术和网络词。不要每段总结，不用命运齿轮、眸光一闪等套话。场景末完成当场决定，可保留后续悬念。","quoteOffset":0,"versionSource":"actual_content_read","currentHash":"7c76d0ac1289ce22ec2af937ae3ef096560769633aecd8841941fb3b2beb5839","sourceCurrent":true,"quoteLocated":true,"observed":true,"verified":true}],"resolution":null,"evidenceComplete":true,"verified":false,"sourceSnapshots":{"style:memory":"第三人称有限视角，一场只跟随一个焦点人物。用动作和对话呈现冲突，不给他人直接内心独白。禁用现代技术和网络词。不要每段总结，不用命运齿轮、眸光一闪等套话。场景末完成当场决定，可保留后续悬念。"}}]}
