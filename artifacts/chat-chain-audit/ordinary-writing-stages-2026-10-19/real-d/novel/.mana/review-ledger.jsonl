{"schemaVersion":1,"eventId":"28030c5e-8129-4f3b-ba38-ef991198290b","timestamp":"2026-10-19T10:21:44.585Z","type":"review_recorded","taskId":"msg-6d05ddca-cd7a-4308-adab-3bb20edb7a6f","attemptId":"attempt-92537e31-da0f-43e5-8e9e-e251442b050e","runId":"run-a622dee6-fd1e-4362-be56-482e40b5b3f6","reportSha256":"7a03341e465da93b1403687e95064cf2878407d1afee223c4e9255cd5a4b09ea","parsed":true,"coverageClaimed":["chapter:chapter-002.md"],"coverageObserved":["world:lore","outline:hierarchy","outline:master","style:memory","chapter:chapter-001.md","world:places","character:cen","character-memory:cen","character:he","character-memory:he","character:lin","character-memory:lin","character:lu","character-memory:lu","character:su","character-memory:su","character:ye","character-memory:ye","chapter:chapter-002.md"],"coverageHashes":[{"resourceRef":"chapter:chapter-002.md","hash":"4373c6e9dba159e9534c7ef63dd6725e5a2e925655ed3328a38f3a0e5b71e3d8"},{"resourceRef":"world:lore","hash":"1d840b6aad84b6728ae68fa26509f29591a266edf805e35d7ead815cc8bd031c"},{"resourceRef":"outline:hierarchy","hash":"afa14801b02d4436f28503d2a4c6af9af8a42e0d462735bf239d0879134291f0"},{"resourceRef":"outline:master","hash":"7e36c4d2b0d88a30c85b2752e9c71f543e23e88d6de3f0189bfd6c2a97a3ea91"},{"resourceRef":"style:memory","hash":"7c76d0ac1289ce22ec2af937ae3ef096560769633aecd8841941fb3b2beb5839"},{"resourceRef":"chapter:chapter-001.md","hash":"d4fa8447125a0377f845b75a59ffda5bdef62251e972defe152f51e30a6be78c"},{"resourceRef":"world:places","hash":"85fff9d9e5cd2a8e5ba729b24fe75d6500718f44c2ca897dab1c0781f3105415"},{"resourceRef":"character:cen","hash":"475c205c4f4780946b7a2318a80e32c3cbfbd4fcb206f782783f4bbc34d305d4"},{"resourceRef":"character-memory:cen","hash":"b02709b82c271a985cc45091dd73b836202263b9ac49eacaa9acbeeb7a9f068b"},{"resourceRef":"character:he","hash":"ad31de7e9751cce0c2df369151170b9d504a43ba1540923f3410ded2b60ffc19"},{"resourceRef":"character-memory:he","hash":"0e71782aeaacf456cb1254fcf30afe04630b1daf6