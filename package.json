{
  "name": "multi-agent-novel-assistant",
  "version": "0.0.9",
  "description": "A multi-platform Electron application",
  "main": "main.js",
  "scripts": {
    "test": "node scripts/run-test-script.js",
    "dev": "npm run start",
    "dev:auth": "node scripts/dev-auth.js",
    "dev:auth:fresh": "node scripts/dev-auth.js --fresh",
    "start": "node scripts/dev-start.js",
    "build": "node scripts/build-release.js",
    "build:beta": "node scripts/build-release.js",
    "build:win": "node scripts/build-release.js --win",
    "build:portable:win": "node scripts/build-release.js --win portable",
    "build:mac": "node scripts/build-release.js --mac",
    "build:portable:mac": "node scripts/build-release.js --mac zip",
    "build:linux": "node scripts/build-release.js --linux",
    "build:portable:linux": "node scripts/build-release.js --linux AppImage"
  },
  "keywords": [
    "Electron",
    "quick",
    "start",
    "tutorial",
    "demo"
  ],
  "author": "GitHub",
  "license": "CC0-1.0",
  "engines": {
    "node": "24.19.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "^9.2.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.mana.app",
    "productName": "MultiAgentNovelAssistant",
    "files": [
      "main.js",
      "preload.js",
      "mcp-server-entry.js",
      "src/domain/**/*",
      "src/main/**/*",
      "dist/**/*",
      "!dist/win-unpacked/**/*",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!dist/*.yml",
      "package.json",
      "!node_modules/.cache",
      "!src/main/feishu/feishuAdapter.js",
      "!**/*.md",
      "!**/*.test.js"
    ],
  "extraResources": [
    {
      "from": ".cache/codex-runtime/staging",
      "to": "codex-runtime"
    },
    {
      "from": "resources/codex-skills",
      "to": "codex-skills"
    },
    {
      "from": ".cache/release-public-config.json",
      "to": "release-public-config.json"
    }
  ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MultiAgentNovelAssistant",
      "uninstallDisplayName": "MultiAgentNovelAssistant",
      "deleteAppDataOnUninstall": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "binaries": [
        "Contents/Resources/codex-runtime/codex",
        "Contents/Resources/codex-runtime/codex-code-mode-host"
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@heroui/react": "3.2.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@react-aria/i18n": "3.13.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@tailwindcss/postcss": "4.1.18",
    "@xyflow/react": "^12.10.2",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "diff-match-patch": "^1.0.5",
    "epub": "^2.1.1",
    "fast-glob": "^3.3.3",
    "framer-motion": "^12.38.0",
    "https-proxy-agent": "^5.0.1",
    "lucide-react": "^0.563.0",
    "postcss": "8.5.26",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.4",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.1.18"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "fast-uri": "3.1.6",
    "ip-address": "10.5.0",
    "qs": "6.15.3"
  }
}
