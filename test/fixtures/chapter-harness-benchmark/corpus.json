    "mist-harbor": {
      "title": "雾港夜航",
      "style": "克制的近距离第三人称。动作和环境承担情绪，不使用解释性总结；对话短而有潜台词。",
      "characters": [
        { "id": "lin-ye", "name": "林夜", "personality": "谨慎、寡言，习惯先观察出口", "speechStyle": "短句，很少反问" },
        { "id": "su-qiao", "name": "苏桥", "personality": "敏锐但会掩饰紧张", "speechStyle": "用具体事实替代情绪判断" }
      ],
      "chapters": [
        "林夜在雾港接到一只没有寄件人的铁盒。",
        "苏桥确认铁盒来自十二年前停航的白礁线。",
        "两人在旧票房找到被撕去一角的夜航表。",
        "守夜人否认见过铁盒，却说漏了白礁钟声。",
        "林夜发现铁盒夹层里有一枚蓝铜钥匙。",
        "苏桥独自查到钥匙属于港务档案室，但没有告诉林夜。",
        "暴雨封住北堤，两人改从修船坞进入旧港。",
        "修船坞的账册显示白礁线最后一班船并未沉没。",
        "林夜把账册页藏进外套内袋，钥匙仍由他保管。",
        "午夜前，两人在档案室门外会合；苏桥仍隐瞒钥匙来历，林夜右手被铁丝划伤。"
      ],
      "summaries": ["收到铁盒", "确认航线", "发现航表", "守夜人露馅", "找到钥匙", "苏桥隐瞒调查", "转入旧港", "发现未沉没记录", "藏起账页", "抵达档案室并保留秘密"],
      "nodes": [
