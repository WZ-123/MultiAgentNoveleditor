    "paper-lantern": {
      "title": "纸灯旧城",
      "style": "第一人称回忆体，语气温和但不煽情；以旧物和称呼表现亲疏，不使用网络流行语。",
      "characters": [
        { "id": "xu-zhi", "name": "徐枝", "personality": "细心、念旧，不愿当面指责家人", "speechStyle": "委婉，常省略主语" },
        { "id": "a-po", "name": "阿婆", "personality": "嘴硬心软，重视旧礼", "speechStyle": "旧城口语，称徐枝为枝囡" }
      ],
      "chapters": [
        "我回到旧城，发现灯铺门上换了新锁。",
        "邻居说阿婆住进了河西的小院。",
        "我在阁楼找到父亲留下的半张灯样。",
        "阿婆见我时只问火车累不累。",
        "她否认收藏过另一半灯样。",
        "我替她修好院里的竹帘。",
        "雨天停电，阿婆点起父亲做的旧纸灯。",
        "灯骨内侧露出与半张灯样相同的墨记。",
        "我没有拆灯，只把发现告诉阿婆。",
        "阿婆答应次日回灯铺，却把旧纸灯留在河西小院。"
      ],
      "summaries": ["回到旧城", "找到阿婆", "发现灯样", "重逢", "否认收藏", "修竹帘", "点旧灯", "发现墨记", "坦白发现", "约定回灯铺"],
      "nodes": [
        { "id": "pl-10a", "title": "插入的清晨", "summary": "插入在原第十章之后：我先到灯铺开窗，阿婆尚未抵达，旧纸灯仍在河西小院", "chapterIndex": 11, "chapterRef": "chapter-010a.md", "characters": ["xu-zhi"], "location": "灯铺", "when": "次日清晨", "pov": "xu-zhi", "mustHappen": ["我独自打开灯铺窗户"], "mustNotHappen": ["旧纸灯已经出现在灯铺", "阿婆改用现代网络流行语"] }
      ],
