        { "id": "mh-11-b", "title": "空柜", "summary": "两人发现白礁线档案柜已被提前清空，只留下潮湿盐痕", "chapterIndex": 11, "chapterRef": "chapter-011.md", "characters": ["lin-ye", "su-qiao"], "location": "港务档案室", "when": "午夜后", "pov": "lin-ye", "mustHappen": ["档案柜已被清空"], "mustNotHappen": ["揭晓白礁线失踪者的最终去向"] }
      ],
