    "broken-beacon": {
      "title": "断轨信标",
      "style": "冷静、精确的科幻叙事；技术细节只写角色可感知的后果，避免百科式说明。",
      "characters": [
        { "id": "chen-an", "name": "陈岸", "personality": "守规程，受伤时也不夸大", "speechStyle": "先报数据，再下判断" },
        { "id": "luo-xi", "name": "洛汐", "personality": "行动果断，对未知保持敬畏", "speechStyle": "简洁命令句" }
      ],
      "chapters": [
        "勘测艇在断轨区捕获一段重复信号。",
        "陈岸确认信号周期不符合任何现役信标。",
        "洛汐申请靠近废弃中继站。",
        "艇体被碎片擦伤，左舷推进器降至六成。",
        "维修无人机补住裂口，却耗尽备用树脂。",
        "信号里出现勘测艇三小时后的识别码。",
        "陈岸拒绝把未来信号写入公开日志。",
        "洛汐把唯一的磁钥交给陈岸保管。",
        "两人穿过失压连廊，氧气余量降至四十分钟。",
        "陈岸留在中继站控制舱，左腿固定；洛汐已前往相隔两公里的天线舱，磁钥仍在陈岸手中。"
      ],
      "summaries": ["发现信号", "识别异常", "申请靠近", "推进器受损", "耗尽树脂", "收到未来识别码", "隐瞒信号", "移交磁钥", "穿过连廊", "两人分处控制舱和天线舱"],
